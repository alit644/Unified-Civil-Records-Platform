generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  passwordHash  String?
  role          Role         @default(OFFICER)
  banned        Boolean?     @default(false)
  banReason     String?
  banExpires    DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  auditLogs     AuditLog[]
  civilEvents   CivilEvent[]
  documents     Document[]
  emailVerified Boolean      @default(false)
  image         String?
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("Employee")
}

model Citizen {
  id               String        @id @default(cuid())
  nationalId       String        @unique // الرقم الوطني (يجب أن يكون فريداً)
  // البيانات الشخصية
  firstName        String // الاسم
  lastName         String // الكنية/العائلة
  fatherName       String // اسم الأب
  motherName       String // اسم الأم
  // تفاصيل الولادة
  placeOfBirth     String // مكان الولادة
  dateOfBirth      DateTime // تاريخ الولادة
  // تفاصيل القيد (مهم جداً في السجل المدني)
  registryPlace    String // أمانة السجل المدني / مكان القيد
  registryNumber   String // رقم القيد (الخانة)
  familyBookId     String? // رقم دفتر العائلة
  // الحالة الشخصية
  gender           Gender
  maritalStatus    MaritalStatus @default(SINGLE)
  status           CitizenStatus @default(ACTIVE)
  religion         String? // الديانة
  currentAddress   String?
  // ==========================================
  // 6. الروابط الأسرية البرمجية (Self-Relations)
  // ==========================================
  fatherId         String?
  motherId         String?
  // من هو الأب ومن هي الأم؟
  father           Citizen?      @relation("FatherToChildren", fields: [fatherId], references: [id])
  mother           Citizen?      @relation("MotherToChildren", fields: [motherId], references: [id])
  // من هم الأبناء؟ (السحر الذي سيجلب لك شجرة العائلة)
  childrenAsFather Citizen[]     @relation("FatherToChildren")
  childrenAsMother Citizen[]     @relation("MotherToChildren")

  // العلاقات
  primaryEvents   CivilEvent[] @relation("PrimaryCitizenEvent")
  secondaryEvents CivilEvent[] @relation("SecondaryCitizenEvent")
  
  documents   Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // search
  @@index([nationalId]) // تسريع البحث بالرقم الوطني
  @@index([firstName, lastName]) // تسريع البحث بالاسم
  @@index([fatherId]) // تسريع البحث بالأب
  @@index([motherId]) // تسريع البحث بالأم
}

model CivilEvent {
  id               String      @id @default(cuid())
  eventType        EventType

  // 1. التوثيق الإداري (من مخططك الرائع)
  eventNumber      String      @unique // رقم الواقعة في السجل (متسلسل)
  status           EventStatus @default(PENDING)
  notes            String?

// 2. التواريخ
  eventDate        DateTime    // تاريخ حدوث الواقعة (مثال: تاريخ الولادة في المشفى)
  registrationDate DateTime    @default(now()) // تاريخ الإدخال للنظام
  finalDate        DateTime?   // تاريخ الاعتماد النهائي من المدير

// 3. المراجع الورقية
  location         String?     // مكان الحدوث (اسم المشفى أو المحكمة)
  documentNumber   String?     // رقم الوثيقة المرجعية (شهادة المشفى)
  
// 🌟 4. أطراف الواقعة (السر البرمجي للزواج والطلاق) 🌟
  // الطرف الأول (الطفل في الولادة، الزوج في الزواج، المتوفى في الوفاة)
  primaryCitizenId String
  primaryCitizen   Citizen     @relation("PrimaryCitizenEvent", fields: [primaryCitizenId], references: [id])

  // الطرف الثاني (اختياري: الزوجة في الزواج/الطلاق، ولا يُستخدم في الولادة)
  secondaryCitizenId String?
  secondaryCitizen   Citizen?  @relation("SecondaryCitizenEvent", fields: [secondaryCitizenId], references: [id])

  employeeId       String
  employee         Employee    @relation(fields: [employeeId], references: [id])
  documents        Document[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Document {
  id            String      @id @default(cuid())
  archiveNumber String      @unique
  type          String
  fileUrl       String?
  fileSize      Int?
  issuedAt      DateTime    @default(now())
  citizenId     String
  eventId       String?
  employeeId    String
  citizen       Citizen     @relation(fields: [citizenId], references: [id])
  employee      Employee    @relation(fields: [employeeId], references: [id])
  event         CivilEvent? @relation(fields: [eventId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  tableName  String
  recordId   String
  oldData    Json?
  newData    Json?
  createdAt  DateTime @default(now())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
}

enum Role {
  ADMIN
  OFFICER
  AUDITOR
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum CitizenStatus {
  ACTIVE
  PENDING
  DECEASED
  INACTIVE
}

enum EventType {
  BIRTH
  MARRIAGE
  DIVORCE
  DEATH
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
}

// Tables for better-auth

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  employee       Employee @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  employee              Employee  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
